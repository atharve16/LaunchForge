# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000

# Supabase Auth (never use a service-role key in this application)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# PostgreSQL. Keep these credentials different and store their values outside source control.
# DATABASE_URL: least-privilege runtime role through the Supabase pooler.
DATABASE_URL=
# DIRECT_URL: migration-owner direct connection; used only by Prisma migration commands.
DIRECT_URL=

# HMAC secret used only to deduplicate public lead submissions. Generate at least 32 random bytes.
LEAD_DEDUP_SECRET=replace-with-a-long-random-value

