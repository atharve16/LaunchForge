# Public browser-safe values only. Never add service-role or database credentials here.
# NEXT_PUBLIC_* values are embedded into browser assets at build time. Set them before `next build`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. When unset, the contact page labels calendar booking as unavailable.
NEXT_PUBLIC_BOOKING_URL=
